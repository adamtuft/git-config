#! /usr/bin/env bash

is_repo() {
    git -C "$1" rev-parse --is-inside-work-tree
}

update_index() {
    git -C "$1" update-index --really-refresh
}

has_modifications() {
    if git -C "$1" diff-index --quiet HEAD --; then
        return 1
    else
        return 0
    fi
}

list_untracked() {
    git -C "$1" ls-files --others --exclude-standard
}

repo="${1:-$PWD}"

STATUS_WARN='⚠️'
STATUS_UNTRACKED='🚩'
if ! is_repo "$repo" &>/dev/null; then
    return 0
fi
update_index "$repo" &>/dev/null;
if has_modifications "$repo" &>/dev/null; then
    echo "$STATUS_WARN Tracked files modified"
    exit 1
elif [[ -n $(list_untracked "$repo") ]]; then
    echo "$STATUS_UNTRACKED Untracked files present"
    exit 1
fi
exit 0
