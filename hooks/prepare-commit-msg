#! /usr/bin/env bash

# Check that the commit message has a valid subject line
#
# If the commit is being authored by an agent, require
# a valid description too.
#
# If not agentic, skip checking for a valid description.

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

if [[ ! -f ~/.config/git/scripts/util.sh ]]; then
    echo "Error: git util script not found, can't validate commit message"
    exit 1
fi

source ~/.config/git/scripts/util.sh

commit_message_has_valid_subject <(grep -v "^#" "$COMMIT_MSG_FILE") >&2 || exit 1

if is_agentic; then
    commit_message_has_valid_body <(grep -v "^#" "$COMMIT_MSG_FILE") >&2 || exit 1
    require_agent_model_id_in_env AGENT_MODEL_ID >&2 || exit 1
    agent_attrib="unknown agent <agent@example.com>"
    get_agent_attrib agent_attrib "${AGENT_MODEL_ID}"
    cat << EOF >> "$COMMIT_MSG_FILE"

Co-authored by: $agent_attrib
EOF
fi
