#! /usr/bin/env bash

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

if [[ ! -f ~/.config/git/scripts/util.sh ]]; then
    echo "Error: git util script not found, can't validate commit message"
    exit 1
fi

source ~/.config/git/scripts/util.sh

if ! commit_message_is_valid "$COMMIT_MSG_FILE" >&2; then
    exit 1
fi

if is_agentic; then
    require_agent_model_id_in_env AGENT_MODEL_ID >&2 || exit 1
    agent_attrib="unknown agent <agent@example.com>"
    get_agent_attrib agent_attrib "${AGENT_MODEL_ID}"
    cat << EOF >> "$COMMIT_MSG_FILE"

Co-authored by: $agent_attrib
EOF
fi
